plugins {
    id("com.android.application")
    id("org.jetbrains.kotlin.android")
    id("org.jetbrains.kotlin.plugin.compose")
{{plugins}}}

buildscript {
    configurations.named("classpath") {
        resolutionStrategy.activateDependencyLocking()
    }
}

dependencyLocking {
    lockAllConfigurations()
    lockMode.set(LockMode.STRICT)
}

configurations.configureEach {
    // Build tooling libraries moved to releases that fix their published security advisories.
    resolutionStrategy.eachDependency {
        val patched = mapOf(
            "io.netty" to "4.1.141.Final", "org.bouncycastle" to "1.87", "org.apache.commons:commons-compress" to "1.28.0",
            "org.bitbucket.b_c:jose4j" to "0.9.7", "org.jdom:jdom2" to "2.0.6.1", "com.google.protobuf:protobuf-java" to "3.25.9",
            "com.google.protobuf:protobuf-java-util" to "3.25.9", "com.google.protobuf:protobuf-kotlin" to "3.25.9",
        )
        val version = patched["${requested.group}:${requested.name}"] ?: patched[requested.group]?.takeUnless { requested.name.startsWith("netty-tcnative") }
        if (version != null) useVersion(version)
        if (requested.group == "com.google.guava" && requested.name == "guava" && requested.version?.endsWith("-jre") == true) useVersion("33.7.2-jre")
    }
}

// Version comes from the git tag in CI (-PversionName=1.2.3); local builds use 0.0.0-dev.
val versionNameProp = (findProperty("versionName") as String?) ?: "0.0.0-dev"
val versionCodeProp = (findProperty("versionCode") as String?)?.toInt() ?: 1

// Release signing from environment variables set by CI, supplied by reference; absent locally.
val keystorePath = System.getenv("{{signingPrefix}}_KEYSTORE")

android {
    namespace = "{{packageId}}"
    compileSdk = {{compileSdk}}

    defaultConfig {
        applicationId = "{{packageId}}"
        manifestPlaceholders["applicationName"] = "{{applicationName}}"
        minSdk = {{minSdk}}
        targetSdk = {{compileSdk}}
        versionCode = versionCodeProp
        versionName = versionNameProp
{{buildConfigFields}}    }

    signingConfigs {
        if (keystorePath != null) {
            create("release") {
                storeFile = file(keystorePath)
                storePassword = System.getenv("{{signingPrefix}}_KEYSTORE_PASSWORD")
                keyAlias = System.getenv("{{signingPrefix}}_KEY_ALIAS")
                keyPassword = System.getenv("{{signingPrefix}}_KEY_PASSWORD")
            }
        }
    }

    buildTypes {
        release {
            isMinifyEnabled = false
            if (keystorePath != null) signingConfig = signingConfigs.getByName("release")
        }
    }

    buildFeatures {
        compose = true
        buildConfig = true
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    kotlin {
        jvmToolchain(17)
    }
{{componentSourceSets}}}

dependencies {
    val bom = platform("androidx.compose:compose-bom:2025.12.01")
    implementation(bom)
    implementation("androidx.compose.ui:ui")
    implementation("androidx.compose.material3:material3")
    implementation("androidx.activity:activity-compose:1.12.4")
    implementation("androidx.lifecycle:lifecycle-runtime-compose:2.10.0")
{{dependencies}}}
